# Deny by default: only runtime sources and locked dependencies enter the context.
**
!Dockerfile
!.dockerignore
!index.html
!app.js
!styles.css
!auth.css
!js/
!js/*.js
!assets/
!assets/*.svg
!backend/
!backend/package.json
!backend/package-lock.json
!backend/server.js
!backend/services-schema.js
!backend/src/
!backend/src/**/
!backend/src/**/*.js

# Explicit exclusions remain effective even inside allowed source directories.
**/.git
**/.env
**/.env.*
**/node_modules
**/backup
**/backups
**/dumps
**/docs
**/tmp
**/temp
**/logs
**/.cache
**/.artifacts
**/coverage
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.backup
**/*.dump
**/*.sql
**/*.sql.gz
**/*.sql.zip
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
**/secrets.json
