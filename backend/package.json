{
  "name": "controle-financeiro-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check:db": "node scripts/check-db.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration.mysql.js tests/password-reset.mysql.js tests/relational.mysql.js",
    "test:mysql:isolated": "node scripts/test-mysql-isolated.js",
    "migrate:state": "node scripts/migrate-app-state.js",
    "audit:migration": "node scripts/audit-migration.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.0.0"
  },
  "devDependencies": {
    "jsdom": "^30.0.1"
  }
}
